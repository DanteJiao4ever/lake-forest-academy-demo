NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://lfa_api:replace-me@127.0.0.1:5432/lfa_learning
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Cloud Run only: /cloudsql/project:region:instance. This overrides the host
# in DATABASE_URL and disables application-level TLS (the Auth Proxy encrypts it).
INSTANCE_UNIX_SOCKET=

# Exact browser origins permitted to send credentialed requests.
ALLOWED_ORIGINS=https://lakeforestacademy.ca,https://www.lakeforestacademy.ca,http://localhost:5173,http://127.0.0.1:5173
# Development value. Production must use __Host-lfa_session.
COOKIE_NAME=lfa_session
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
BCRYPT_COST=12
CSRF_SECRET=replace-with-at-least-32-random-bytes-from-secret-manager

# Password recovery. Production stays fail-closed until Gmail API delivery is
# explicitly enabled. The service account must have Workspace domain-wide
# delegation for gmail.send and gmail.metadata, impersonating the mailbox below.
# The From address must be that same mailbox. Keep its JSON in Secret Manager
# via the existing Google credentials settings; never commit it.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=https://lakeforestacademy.ca/learning/#/reset-password
PASSWORD_RESET_MAIL_PROVIDER=disabled
PASSWORD_RESET_FROM_EMAIL=no-reply@lakeforestacademy.ca
PASSWORD_RESET_FROM_NAME=Lake Forest Academy
GMAIL_IMPERSONATED_USER=no-reply@lakeforestacademy.ca
# Prefer a dedicated, least-privilege delegated service account. If both are
# empty, the mail adapter falls back to the Google credentials below.
GMAIL_SERVICE_ACCOUNT_JSON_BASE64=
GMAIL_APPLICATION_CREDENTIALS=

# Optional local Google service-account credentials.
# On Cloud Run, leave both empty and share the approved folders with the
# runtime service account; googleapis then uses Application Default Credentials.
# For local development, use either path or base64-encoded JSON below.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=

# Keep school Drive identifiers in deployment configuration rather than source.
CURRICULUM_DRIVE_ROOT_ID=
CURRICULUM_DRIVE_ROOT_NAME=Lotus Academy Formal Course Pilots - Text Based
SUBMISSION_TARGET_ROOT_ID=

# ClamAV INSTREAM scanning. Required in production unless a different scanner
# is injected by the deployment adapter.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

MAX_UPLOAD_FILES=1
MAX_FILE_BYTES=26214400
MAX_REQUEST_BYTES=29360128

# Optional first-party Workspace OAuth may be added without changing the
# cookie session contract. Faculty users are provisioned with create-user.
